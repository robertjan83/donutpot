rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // A name/email string in client JavaScript is not sufficient. Require
    // the verified email claim in the Firebase ID token on the server.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'rjpeetoom@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function keysOnly(fields) {
      return request.resource.data.keys().hasOnly(fields)
        && request.resource.data.keys().hasAll(fields);
    }
    function validName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 24;
    }
    function validCustomDiscount() {
      return !request.resource.data.keys().hasAny(['customDiscount'])
        || (
          request.resource.data.customDiscount is map
          && request.resource.data.customDiscount.keys().hasOnly(['minDonuts', 'percent'])
          && request.resource.data.customDiscount.keys().hasAll(['minDonuts', 'percent'])
          && request.resource.data.customDiscount.minDonuts is int
          && request.resource.data.customDiscount.minDonuts >= 1
          && request.resource.data.customDiscount.minDonuts <= 999
          && request.resource.data.customDiscount.percent is int
          && request.resource.data.customDiscount.percent >= 0
          && request.resource.data.customDiscount.percent <= 100
        );
    }
    function validBirthday() {
      return !request.resource.data.keys().hasAny(['birthday'])
        || (
          request.resource.data.birthday is map
          && request.resource.data.birthday.keys().hasOnly(['month', 'day'])
          && request.resource.data.birthday.keys().hasAll(['month', 'day'])
          && request.resource.data.birthday.month is int
          && request.resource.data.birthday.day is int
          && request.resource.data.birthday.month >= 1
          && request.resource.data.birthday.month <= 12
          && request.resource.data.birthday.day >= 1
          && request.resource.data.birthday.day <= 31
          && (request.resource.data.birthday.month != 2 || request.resource.data.birthday.day <= 29)
          && (!(request.resource.data.birthday.month in [4, 6, 9, 11]) || request.resource.data.birthday.day <= 30)
        );
    }
    match /offers/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && keysOnly(['owner', 'startMs', 'endMs', 'maxDonuts', 'percent', 'createdAt', 'createdBy'])
        && request.resource.data.owner is string
        && exists(/databases/$(database)/documents/players/$(request.resource.data.owner))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.startMs is int
        && request.resource.data.endMs is int
        && request.resource.data.startMs > 0
        && request.resource.data.endMs > request.resource.data.startMs
        && request.resource.data.endMs - request.resource.data.startMs <= 365 * 86400000
        && request.resource.data.maxDonuts is int
        && request.resource.data.maxDonuts >= 1
        && request.resource.data.maxDonuts <= 999
        && request.resource.data.percent is int
        && request.resource.data.percent >= 0
        && request.resource.data.percent <= 100;
      // Immutable promotions: a past earned reduction cannot be erased.
      allow update, delete: if false;
    }
    match /players/{uid} {
      allow read: if signedIn();
      // Players cannot assign themselves an admin discount on signup.
      allow create: if signedIn()
        && request.auth.uid == uid
        && keysOnly(['name', 'createdAt'])
        && validName()
        && request.resource.data.createdAt == request.time;
      allow update: if (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && validName()
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customDiscount', 'birthday'])
          && validCustomDiscount()
          && validBirthday()
        );
      allow delete: if false;
    }
    match /donuts/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner is string
        && request.resource.data.paid == false
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.owner == request.auth.uid
            && keysOnly(['owner', 'paid', 'createdAt'])
          )
          || (
            request.resource.data.owner == request.auth.uid
            && keysOnly(['owner', 'paid', 'createdAt', 'quizPrizeRound'])
            && request.resource.data.quizPrizeRound is string
            && get(/databases/$(database)/documents/quizPrizes/$(request.resource.data.quizPrizeRound)).data.owner == request.auth.uid
            && get(/databases/$(database)/documents/quizPrizes/$(request.resource.data.quizPrizeRound)).data.redeemedDonutId == null
            && getAfter(/databases/$(database)/documents/quizPrizes/$(request.resource.data.quizPrizeRound)).data.redeemedDonutId == id
          )
          || (
            isAdmin()
            && keysOnly(['owner', 'paid', 'createdAt', 'addedBy'])
            && request.resource.data.addedBy == request.auth.uid
            && exists(/databases/$(database)/documents/players/$(request.resource.data.owner))
          )
        );
      allow update: if (
          signedIn()
          && resource.data.owner == request.auth.uid
          && resource.data.paid == false
          && resource.data.get('voided', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid'])
          && request.resource.data.paid == true
        ) || (
          isAdmin()
          && resource.data.get('voided', false) != true
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['voided', 'voidedBy', 'voidedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasAll(['voided', 'voidedBy', 'voidedAt'])
          && request.resource.data.voided == true
          && request.resource.data.voidedBy == request.auth.uid
          && request.resource.data.voidedAt == request.time
        );
      // Preserve corrected donut records as an audit trail; never delete them.
      allow delete: if false;
    }
    // One shared state pointer: players cannot jump to a later unlocked round.
    match /quizState/{stateId} {
      allow get, list: if signedIn();
      allow create: if isAdmin()
        && stateId == 'main'
        && keysOnly(['currentRoundId', 'createdAt'])
        && request.resource.data.currentRoundId == 'q01'
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && stateId == 'main'
        && resource.data.currentRoundId != 'done'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['currentRoundId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/quizRounds/$(resource.data.currentRoundId)).data.winnerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/quizRounds/$(resource.data.currentRoundId)).data.nextId == request.resource.data.currentRoundId;
      allow delete: if false;
    }
    // Public rounds omit answer keys; winning requires one atomic transaction.
    match /quizRounds/{roundId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && keysOnly(['index', 'startMs', 'nextId', 'winnerUid', 'createdAt'])
        && request.resource.data.index is int
        && request.resource.data.index >= 1 && request.resource.data.index <= 25
        && request.resource.data.startMs is int
        && request.resource.data.startMs > 0
        && request.resource.data.nextId is string
        && request.resource.data.winnerUid == null
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.winnerUid == null
        && get(/databases/$(database)/documents/quizState/main).data.currentRoundId == roundId
        && request.time.toMillis() >= resource.data.startMs
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['winnerUid', 'winningChoice', 'answeredAt'])
        && request.resource.data.winnerUid == request.auth.uid
        && request.resource.data.winningChoice in ['A', 'B', 'C', 'D']
        && request.resource.data.answeredAt == request.time
        && get(/databases/$(database)/documents/quizAnswers/$(roundId)).data.answer == request.resource.data.winningChoice
        && get(/databases/$(database)/documents/quizRounds/$(roundId)/attempts/$(request.auth.uid)).data.owner == request.auth.uid
        && get(/databases/$(database)/documents/quizRounds/$(roundId)/attempts/$(request.auth.uid)).data.choice == request.resource.data.winningChoice
        && getAfter(/databases/$(database)/documents/quizPrizes/$(roundId)).data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/quizState/main).data.currentRoundId == resource.data.nextId;
      allow delete: if false;
      match /attempts/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        // Exactly one immutable submitted guess; the hidden answer is checked
        // only AFTER this document already exists in committed Firestore state.
        allow create: if signedIn() && request.auth.uid == uid
          && keysOnly(['owner','choice','answeredAt'])
          && request.resource.data.owner == uid
          && request.resource.data.choice in ['A','B','C','D']
          && request.resource.data.answeredAt == request.time
          && get(/databases/$(database)/documents/quizState/main).data.currentRoundId == roundId
          && get(/databases/$(database)/documents/quizRounds/$(roundId)).data.winnerUid == null
          && request.time.toMillis() >= get(/databases/$(database)/documents/quizRounds/$(roundId)).data.startMs;
        allow update, delete: if false;
      }
    }
    // Secret answer keys can be CREATED by the verified admin, but NEVER read
    // through the client SDK. Security Rules alone compare guesses with keys.
    match /quizAnswers/{id} {
      allow read: if false;
      allow create: if isAdmin()
        && keysOnly(['answer','createdAt'])
        && request.resource.data.answer in ['A','B','C','D']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // One winner, one prize per round. A prize is spent in the same atomic
    // transaction that creates its uniquely linked next donut.
    match /quizPrizes/{roundId} {
      allow get, list: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn()
        && keysOnly(['owner','awardedAt','redeemedDonutId'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.awardedAt == request.time
        && request.resource.data.redeemedDonutId == null
        && getAfter(/databases/$(database)/documents/quizRounds/$(roundId)).data.winnerUid == request.auth.uid
        && get(/databases/$(database)/documents/quizRounds/$(roundId)/attempts/$(request.auth.uid)).data.owner == request.auth.uid
        && get(/databases/$(database)/documents/quizRounds/$(roundId)/attempts/$(request.auth.uid)).data.choice ==
           get(/databases/$(database)/documents/quizAnswers/$(roundId)).data.answer;
      allow update: if signedIn()
        && resource.data.owner == request.auth.uid
        && resource.data.redeemedDonutId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedDonutId','redeemedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['redeemedDonutId','redeemedAt'])
        && request.resource.data.redeemedDonutId is string
        && request.resource.data.redeemedAt == request.time
        && getAfter(/databases/$(database)/documents/donuts/$(request.resource.data.redeemedDonutId)).data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/donuts/$(request.resource.data.redeemedDonutId)).data.quizPrizeRound == roundId
        && getAfter(/databases/$(database)/documents/donuts/$(request.resource.data.redeemedDonutId)).data.createdAt == request.time;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
